<odoo>
    <data>

        <record id="group_employee_experience_manager_extended" model="res.groups">
            <field name="name">Employee Experience Manager Extended for Hr</field>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="group_manage_certifications" model="res.groups">
            <field name="name">Manager certifications</field>
        </record>

        <record id="group_manage_skills" model="res.groups">
            <field name="name">Manager skill</field>
        </record>

        <record id="rule_employee_experience_manager_skills" model="ir.rule">
            <field name="name">Employee Experience Manager - Skills Access</field>
            <field name="model_id" ref="model_employee_skill"/>
            <field name="groups" eval="[(4, ref('group_employee_experience_manager_extended'))]"/>
            <field name="domain_force">[('employee_id.certifications', '>', 2)]</field>
        </record>

        <record id="rule_certification_manager" model="ir.rule">
            <field name="name">Manager certifications</field>
            <field name="model_id" ref="model_employee_certification"/>
            <field name="groups" eval="[(4, ref('group_manage_certifications'))]"/>
            <field name="domain_force">[]</field>
        </record>

        <record id="rule_skill_manager" model="ir.rule">
            <field name="name">Manager skill</field>
            <field name="model_id" ref="model_employee_skill"/>
            <field name="groups" eval="[(4, ref('group_manage_skills'))]"/>
            <field name="domain_force">[]</field>
        </record>
    </data>
</odoo>
