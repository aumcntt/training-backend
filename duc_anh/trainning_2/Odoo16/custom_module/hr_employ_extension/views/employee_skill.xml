<odoo>
    <data>
        <record id="view_employee_skill_form" model="ir.ui.view">
            <field name="name">employee.skill.form</field>
            <field name="model">employee.skill</field>
            <field name="arch" type="xml">
                <form string="Employee Skill">
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id"/>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="experience_points"/>
                                <field name="years_of_experience"/>
                            </group>
                            <field name="certification_id" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>


