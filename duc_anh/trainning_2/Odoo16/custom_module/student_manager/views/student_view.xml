<odoo>
    <record id="view_student_tree" model="ir.ui.view">
        <field name="name">student.student.tree</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="student_code"/>
                <field name="display_name"/>
                <field name="books_count"/>
                <field name="birth_date"/>
                <field name="email"/>
                <field name="phone"/>
            </tree>
        </field>
    </record>

    <record id="view_student_form" model="ir.ui.view">
        <field name="name">student.student.form</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <group>
                    <field name="name"/>
                    <field name="student_code"/>
                    <field name="birth_date"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="display_name"/>
                </group>
                <xpath expr="//header" position="inside">
                    <button name="action_view_partners" string="Xem liên hệ" type="object" class="oe_highlight"/>
                </xpath>
            </form>
        </field>
    </record>

    <record id="view_student_search" model="ir.ui.view">
        <field name="name">student.student.search</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Tìm kiếm theo tên"/>
                <field name="student_code" string="Tìm kiếm theo mã sinh viên"/>
                <filter string="Nhóm theo ngày sinh" name="group_by_date" context="{'group_by': 'birth_date'}"/>
                 <filter name="filter_books_mounted" string="Có mượn sách" domain="[('book_id', '!=', False)]"/>
            </search>
        </field>
    </record>

    <record id="seq_library_book" model="ir.sequence">
        <field name="name">Library Book Sequence</field>
        <field name="code">library.book.sequence</field>
        <field name="prefix">TV</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>

    <record id="action_student_student" model="ir.actions.act_window">
        <field name="name">Student Records</field>
        <field name="res_model">student.student</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('books_count', '>', 0)]</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="student_menu" name="Students" sequence="10"/>
    <menuitem id="student_submenu" name="Manage Students" parent="student_menu" action="action_student_student"/>
</odoo>
