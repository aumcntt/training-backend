<odoo>
    <record id="view_student_tree" model="ir.ui.view">
        <field name="name">student.student.tree</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="student_code"/>
                <field name="display_name"/>
                <field name="birth_date"/>
                <field name="email"/>
                <field name="phone"/>
            </tree>
        </field>
    </record>

    <record id="view_student_form" model="ir.ui.view">
        <field name="name">student.student.form</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <group>
                    <field name="name"/>
                    <field name="student_code"/>
                    <field name="birth_date"/>
                    <field name="email"/>
                    <field name="phone"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_student_search" model="ir.ui.view">
        <field name="name">student.student.search</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Name" filter_domain="['|', ('name', 'ilike', self)]"/>
                <field name="student_code" string="Student Code" filter_domain="['|', ('name', 'ilike', self)]"/>
            </search>
        </field>
    </record>

    <record id="action_student_student" model="ir.actions.act_window">
        <field name="name">Student Records</field>
        <field name="res_model">student.student</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="student_menu" name="Students" sequence="10"/>
    <menuitem id="student_submenu" name="Manage Students" parent="student_menu" action="action_student_student"/>
</odoo>
